# 환경 설정 예제 파일
# 이 파일을 .env로 복사 후 값을 수정하세요

# ====================
# 모델 설정
# ====================
# 사용할 Stable Diffusion 모델 ID (Hugging Face)
SD_MODEL_ID=runwayml/stable-diffusion-v1-5

# ====================
# 서버 설정
# ====================
# 호스트 주소 (0.0.0.0 = 모든 인터페이스)
SD_HOST=0.0.0.0

# 포트 번호
SD_PORT=8000

# ====================
# 데이터베이스 설정
# ====================
# SQLite 데이터베이스 경로
SD_DB_PATH=sqlite:///sd_database.db

# ====================
# 배치 생성 설정
# ====================
# 자동 배치 생성 시간 (24시간 형식, 0-23)
SD_BATCH_HOUR=2

# ====================
# 이미지 생성 제한
# ====================
# 최대 inference steps
SD_MAX_STEPS=100

# 최대 이미지 크기 (픽셀)
SD_MAX_DIMENSION=1024

# ====================
# 보안 설정
# ====================
# CORS 허용 도메인 (쉼표로 구분, * = 모든 도메인)
# 프로덕션에서는 특정 도메인만 지정하세요
# 예: https://example.com,https://app.example.com
SD_CORS_ORIGINS=*
